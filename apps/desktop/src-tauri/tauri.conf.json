{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "better-outplayed",
  "mainBinaryName": "localplay",
  "version": "0.1.0",
  "identifier": "io.github.fisifla.better-outplayed",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "npm run sidecars:check"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "localplay",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#0b0c10"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$LOCALDATA/localplay/clips/**",
          "$LOCALDATA/localplay/thumbnails/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../binaries/": "binaries/"
    },
    "publisher": "FisiFla",
    "copyright": "Copyright (c) 2026 FisiFla",
    "category": "Video",
    "homepage": "https://github.com/FisiFla/better-outplayed",
    "shortDescription": "Local, zero-cloud game clipping and replay buffer for Windows",
    "longDescription": "better-outplayed keeps the last 30-120 seconds of gameplay in a ring buffer and writes a lossless clip to disk the instant you press a hotkey or your game reports an event. No account, no telemetry, no cloud upload, no Overwolf runtime. Windows 10 1903+ / Windows 11, x86_64, with a hardware encoder (NVENC, QuickSync or AMF).",
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "macOS": {
      "hardenedRuntime": true
    }
  }
}
