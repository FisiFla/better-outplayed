{
  "name": "replayed-desktop",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "replayed desktop shell (Tauri v2 + Svelte 5) — Phase 2 session review UI",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "svelte-check --tsgo --tsconfig ./tsconfig.json",
    "sidecars:check": "node scripts/require-sidecars.mjs",
    "shots": "node scripts/shots.mjs",
    "shots:browser": "node scripts/shots.mjs --install-browser-only",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.8.2"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
