# ============================================================
# localplay — .gitignore
# ============================================================

# --- Rust / Cargo ---
# NOTE: Cargo.lock IS committed (this is a binary application, not a library).
target/
**/target/
**/*.rs.bk
*.pdb
*.profraw
*.profdata

# --- Node / frontend toolchain ---
node_modules/
**/node_modules/
.pnpm-store/
.yarn/
dist/
build/
.vite/
*.tsbuildinfo
.eslintcache

# --- Tauri ---
src-tauri/gen/schemas/
**/src-tauri/target/
*.app
*.dmg
*.msi
*.AppImage
*.deb
*.rpm

# --- Bundled / sidecar binaries ---
# ffmpeg & ffprobe ship as extracted sidecars, never committed.
binaries/
**/binaries/*
!**/binaries/.gitkeep
ffmpeg
ffmpeg.exe
ffprobe
ffprobe.exe
*.exe
*.dll
*.dylib
*.so
*.so.*
*.lib
*.a
!**/*.node

# --- Video caches, scratch disks & recordings ---
# Never commit media: captures, ring-buffer scratch files, clips, thumbnails.
recordings/
clips/
captures/
thumbnails/
scratch/
ringbuffer/
**/scratch/
*.mp4
*.mkv
*.mov
*.webm
*.avi
*.flv
*.ts
*.m4s
*.m2ts
*.part
*.tmp
*.temp
*.cache
# Explicitly keep small test fixtures if they ever land in tree.
!**/fixtures/**/*.txt
!**/fixtures/**/*.json

# --- Local database (SQLite index of matches/clips) ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite3-journal

# --- Secrets & environment ---
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
secrets/
credentials.json
# Windows DPAPI / local config with tokens
*.dpapi

# --- Logs & diagnostics ---
logs/
*.log
crash-*.dmp
report.*.json

# --- OS cruft ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Editors / IDE ---
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*~
.claude/settings.local.json
